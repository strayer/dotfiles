{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "statusLine": {
    "type": "command",
    "command": "PATH=\"/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH\" claude-statusline",
    "padding": 0
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "PATH=\"/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH\" claude-statusline --subagents"
  },
  "tui": "fullscreen",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "env": {
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1"
  }
}
