# Same candidates and order as items/tailscale.lua.
tailscale_cli() {
  local candidate
  for candidate in \
    /Applications/Tailscale.app/Contents/MacOS/tailscale \
    /usr/local/bin/tailscale \
    /opt/homebrew/bin/tailscale; do
    if [ -e "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
}

sketchybar_tailscale_watch_desc() { echo "feeds the SketchyBar Tailscale item with change events"; }
sketchybar_tailscale_watch_label() { echo "earth.gru.sketchybar-tailscale-watch"; }
sketchybar_tailscale_watch_run_id() { sha_file "$BIN/sketchybar-tailscale-watch"; }

sketchybar_tailscale_watch_missing() {
  if [ -z "$(tailscale_cli)" ]; then
    echo "no Tailscale CLI found"
  elif [ ! -x "$BIN/sketchybar-tailscale-watch" ]; then
    echo "$BIN/sketchybar-tailscale-watch not found (run chezmoi apply first)"
  fi
}

# PATH: launchd's default lacks Homebrew, where jq and sketchybar live.
# ThrottleInterval: restart delay while Tailscale is not running.
