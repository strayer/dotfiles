#!/usr/bin/env bash
# dot-services: builds, installs and restarts the daemons and helper programs
# that ship with these dotfiles (macOS only).
#
#   dot-services [status]                   what is enabled, built and running
#   dot-services install [--force] [NAME…]  build/install/restart what changed
#   dot-services restart NAME…              restart a component
#   dot-services uninstall NAME…            stop a component and remove what
#                                           install created
#
# Without names, `install` covers the components enabled for this host: the
# list in ~/.config/dotfiles/services, rendered by chezmoi from
# .chezmoidata/services.yaml. chezmoi runs `dot-services install` itself when
# an input changes (.chezmoiscripts/run_onchange_after_30-dot-services.sh.tmpl).
#
# `install` is idempotent. Each component has a build stamp (a hash of its
# sources and build recipe) and/or a run stamp (inputs that only need a
# restart) in ~/.cache/dot-services. A component is rebuilt when its build
# stamp differs or its artifact is missing; its LaunchAgent is reloaded when
# the generated plist differs from the installed one, and restarted when
# something it runs changed. Everything else is left alone. --force rebuilds
# and restarts regardless.
#
# A component of the host list whose prerequisite is missing (cargo before
# `brew bundle`, no Tailscale, …) is skipped with a warning; one that was
# named on the command line fails instead.
#
# Adding a component: add its name to COMPONENTS and define functions named
# after it (dashes become underscores). All but _desc are optional:
#   NAME_desc         one-line description
#   NAME_missing      print why it can't be installed here; silent when it can
#   NAME_frameworks   Swift app: frameworks to link. Builds ~/.bin/NAME.swift
#                     into ~/.bin/NAME.app; needs NAME_info_plist as well
#   NAME_info_plist   Swift app: print the bundle's Info.plist
#   NAME_build_id     other builds: print what identifies the build inputs
#   NAME_build        other builds: build and install the artifact
#   NAME_artifact     other builds: print the artifact's path
#   NAME_run_id       print what identifies inputs that only need a restart
#   NAME_label        LaunchAgent label
#   NAME_plist        print the LaunchAgent plist
#   NAME_restart      restart something that is not a LaunchAgent and print
#                     what was done, as a phrase for the status line
#   NAME_pid          print the pid of something that is not a LaunchAgent
#   NAME_uninstall    extra cleanup on uninstall
#
# Written for the bash 3.2 that macOS ships.

set -euo pipefail

COMPONENTS="display-refresh-fixer display-profile-fixer sketchybar-network-watcher sketchybar-tailscale-watch rift-log-rotate rift-pip ssh-agent-multiplexer"

BIN="$HOME/.bin"
AGENTS_DIR="$HOME/Library/LaunchAgents"
LOGS_DIR="$HOME/Library/Logs"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dot-services"
ENABLED_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/services"
DOMAIN="gui/$(id -u)"
RC_SKIPPED=75
FORCE=0

# launchd and chezmoi may run this with a PATH that lacks Homebrew.
PATH="$PATH:/opt/homebrew/bin"

log() { printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }
die() {
  warn "error: $*"
  exit 1
}

# Empty for a missing file, so "absent" is a state like any other.
sha_file() { { shasum -a 256 "$1" 2>/dev/null || true; } | cut -d' ' -f1; }
sha_stdin() { shasum -a 256 | cut -d' ' -f1; }

# ---------------------------------------------------------------------------
# Component dispatch
# ---------------------------------------------------------------------------

fn() { printf '%s_%s' "$(printf '%s' "$1" | tr - _)" "$2"; }
has() { declare -F "$(fn "$1" "$2")" >/dev/null; }
call() {
  local f
  f=$(fn "$1" "$2")
  shift 2
  "$f" "$@"
}

is_component() {
  local c
  for c in $COMPONENTS; do
    [ "$c" = "$1" ] && return 0
  done
  return 1
}

enabled_components() {
  [ -f "$ENABLED_FILE" ] || return 0
  grep -v -E '^[[:space:]]*(#|$)' "$ENABLED_FILE" || true
}

is_enabled() {
  local c
  for c in $(enabled_components); do
    [ "$c" = "$1" ] && return 0
  done
  return 1
}

is_swift_app() { has "$1" frameworks; }
has_build() { is_swift_app "$1" || has "$1" build; }

missing_reason() {
  if is_swift_app "$1" && ! xcrun --find swiftc >/dev/null 2>&1; then
    echo "swiftc not found (install Xcode or the Command Line Tools)"
  elif has "$1" missing; then
    call "$1" missing
  fi
}

artifact_path() {
  if is_swift_app "$1"; then
    echo "$BIN/$1.app"
  elif has "$1" artifact; then
    call "$1" artifact
  fi
}

artifact_ok() {
  if is_swift_app "$1"; then
    [ -x "$BIN/$1.app/Contents/MacOS/$1" ]
  else
    [ -e "$(artifact_path "$1")" ]
  fi
}

build_id() {
  if is_swift_app "$1"; then
    printf 'source %s\ninfo %s\nframeworks %s\n' \
      "$(sha_file "$BIN/$1.swift")" \
      "$(call "$1" info_plist | sha_stdin)" \
      "$(call "$1" frameworks)"
  else
    call "$1" build_id
  fi
}

# Compiles ~/.bin/NAME.swift into the ad-hoc signed bundle ~/.bin/NAME.app.
# A bundle (not a bare binary) is what gives the daemon a bundle id, which
# native notifications and Location Services need. The binary is swapped in
# only after a successful compile, so a broken source leaves the running
# version in place.
swift_build() {
  local name=$1 fw
  local bundle="$BIN/$name.app"
  local binary="$bundle/Contents/MacOS/$name"
  local args=()
  [ -f "$BIN/$name.swift" ] || die "$BIN/$name.swift not found (run chezmoi apply first)"
  for fw in $(call "$name" frameworks); do
    args+=(-framework "$fw")
  done
  mkdir -p "$bundle/Contents/MacOS"
  if ! swiftc -O "${args[@]}" "$BIN/$name.swift" -o "$binary.new"; then
    rm -f "$binary.new"
    return 1
  fi
  mv -f "$binary.new" "$binary"
  call "$name" info_plist >"$bundle/Contents/Info.plist"
  # codesign reports "replacing existing signature" on every rebuild; only
  # show its output when it fails.
  local output
  if ! output=$(codesign --force --sign - "$bundle" 2>&1); then
    warn "$output"
    return 1
  fi
}

do_build() {
  if is_swift_app "$1"; then
    swift_build "$1"
  else
    call "$1" build
  fi
}

# ---------------------------------------------------------------------------
# launchd
# ---------------------------------------------------------------------------

agent_loaded() { launchctl print "$DOMAIN/$1" >/dev/null 2>&1; }

agent_pid() {
  # no early `exit` in awk: it would SIGPIPE launchctl and trip pipefail
  launchctl print "$DOMAIN/$1" 2>/dev/null | awk '$1 == "pid" && $2 == "=" && !seen { print $3; seen = 1 }'
}

# bootout is asynchronous; bootstrapping while the old instance is still being
# torn down fails with "Input/output error". Wait until it is gone.
agent_bootout() {
  local i=0
  agent_loaded "$1" || return 0
  launchctl bootout "$DOMAIN/$1" 2>/dev/null || true
  while agent_loaded "$1" && [ "$i" -lt 50 ]; do
    sleep 0.2
    i=$((i + 1))
  done
}

# Re-reads the plist. `kickstart -k` restarts with the plist launchd already
# has, so a changed plist needs bootout + bootstrap.
agent_reload() {
  agent_bootout "$1"
  launchctl bootstrap "$DOMAIN" "$AGENTS_DIR/$1.plist"
}

# daemon_plist [--homebrew-path] LABEL LOGFILE ARG…: a KeepAlive background
# agent. --homebrew-path puts Homebrew on its PATH (launchd's default lacks it).
daemon_plist() {
  local env="" label logfile arg
  if [ "$1" = --homebrew-path ]; then
    env="    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
"
    shift
  fi
  label=$1 logfile=$2
  shift 2
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${label}</string>
    <key>ProgramArguments</key>
    <array>
PLIST
  for arg in "$@"; do
    printf '        <string>%s</string>\n' "$arg"
  done
  printf '    </array>\n%s' "$env"
  cat <<PLIST
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StandardOutPath</key>
    <string>${logfile}</string>
    <key>StandardErrorPath</key>
    <string>${logfile}</string>
</dict>
</plist>
PLIST
}

