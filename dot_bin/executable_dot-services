# ---------------------------------------------------------------------------
# rift-pip (https://github.com/acsandmann/rift-pip)
# Rift plugin that mirrors a window into a floating picture-in-picture window,
# built with the local `--window <id>` patch. No daemon: ~/.bin/rift-pip-auto
# starts it on demand.
# ---------------------------------------------------------------------------

RIFT_PIP_REPO="https://github.com/acsandmann/rift-pip"
RIFT_PIP_REV="06e15a62428dd142750185af3060df897855fc0a" # upstream commit the patch was written against
RIFT_PIP_PATCH="$BIN/src/rift-pip-window-option.patch"

rift_pip_desc() { echo "picture-in-picture for hidden Teams calls (started by rift-pip-auto)"; }
rift_pip_artifact() { echo "$HOME/.cargo/bin/rift-pip"; }
rift_pip_build_id() { printf 'rev %s\npatch %s\n' "$RIFT_PIP_REV" "$(sha_file "$RIFT_PIP_PATCH")"; }

rift_pip_missing() {
  local cmd
  for cmd in git cargo; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "$cmd not found"
      return 0
    fi
  done
  [ -f "$RIFT_PIP_PATCH" ] || echo "$RIFT_PIP_PATCH not found (run chezmoi apply first)"
}

rift_pip_build() {
  local temp_dir
  temp_dir=$(mktemp -d)
  # shellcheck disable=SC2064  # expand now: temp_dir is local
  trap "rm -rf '$temp_dir'" EXIT
  log "rift-pip: cloning at ${RIFT_PIP_REV:0:7}"
  git clone --quiet "$RIFT_PIP_REPO" "$temp_dir/rift-pip"
  git -C "$temp_dir/rift-pip" checkout --quiet "$RIFT_PIP_REV"
  git -C "$temp_dir/rift-pip" apply "$RIFT_PIP_PATCH"
  log "rift-pip: building (this takes a minute)"
  cargo install --quiet --locked --path "$temp_dir/rift-pip" --root "$HOME/.cargo"
  rm -rf "$temp_dir"
  trap - EXIT
  # let rift-pip-auto log again if it goes missing
  rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/rift-pip/rift-pip-missing"
  log "rift-pip: needs Screen Recording permission for the app that launches it (rift, or"
  log "  your terminal when run by hand): System Settings > Privacy & Security > Screen &"
  log "  System Audio Recording. A PiP that fails to start is not retried until the call's"
  log "  workspace has been visible again; see ~/.cache/rift-pip/rift-pip.log."
}

# ---------------------------------------------------------------------------
# ssh-agent-multiplexer (https://github.com/everpeace/ssh-agent-multiplexer)
# Merges the Secretive agent (Secure Enclave git signing key) and the default
# launchd ssh-agent (daily Smallstep certificate) behind a single socket, so
# tools that forward one SSH agent (e.g. Docker Sandboxes) see both keys.
# Config: ~/.config/ssh-agent-multiplexer/config.toml (managed by chezmoi).
#
# Pinned release, verified against the sha256 from the project's
# checksums.txt. Bump both together when updating.
# ---------------------------------------------------------------------------

SSH_MUX_VERSION="0.6.0"
SSH_MUX_SHA256="5ac8d79bdee436a0e6a8c8dbfa53cbfc3c061ac4b48d6de890e7780b53a64cc2" # darwin_arm64
SSH_MUX_BIN="$HOME/.local/bin/ssh-agent-multiplexer"

ssh_agent_multiplexer_desc() { echo "merges the Secretive and launchd SSH agents behind one socket"; }
ssh_agent_multiplexer_label() { echo "local.ssh-agent-multiplexer"; }
ssh_agent_multiplexer_artifact() { echo "$SSH_MUX_BIN"; }
ssh_agent_multiplexer_build_id() { printf 'version %s\nsha256 %s\n' "$SSH_MUX_VERSION" "$SSH_MUX_SHA256"; }
ssh_agent_multiplexer_run_id() { sha_file "${XDG_CONFIG_HOME:-$HOME/.config}/ssh-agent-multiplexer/config.toml"; }

ssh_agent_multiplexer_missing() {
  [ "$(uname -m)" = "arm64" ] || echo "pinned checksum is for darwin_arm64 only"
}

ssh_agent_multiplexer_build() {
  local tarball="ssh-agent-multiplexer_${SSH_MUX_VERSION}_darwin_arm64.tar.gz"
  local url="https://github.com/everpeace/ssh-agent-multiplexer/releases/download/v${SSH_MUX_VERSION}/${tarball}"
  local temp_dir
  temp_dir=$(mktemp -d)
  # shellcheck disable=SC2064  # expand now: temp_dir is local
  trap "rm -rf '$temp_dir'" EXIT
  log "ssh-agent-multiplexer: downloading v${SSH_MUX_VERSION}"
  curl -fsSL -o "$temp_dir/$tarball" "$url"
  echo "${SSH_MUX_SHA256}  $temp_dir/$tarball" | shasum -a 256 -c - >/dev/null
  tar -xzf "$temp_dir/$tarball" -C "$temp_dir" ssh-agent-multiplexer
  mkdir -p "$(dirname "$SSH_MUX_BIN")"
  install -m 755 "$temp_dir/ssh-agent-multiplexer" "$SSH_MUX_BIN"
  rm -rf "$temp_dir"
  trap - EXIT
}

# The upstream launchd agent socket path (/var/run/com.apple.launchd.*/Listeners)
# changes every boot, so the config references ${SSH_AUTH_SOCK} and the
# LaunchAgent resolves it from launchd's user environment at start.
ssh_agent_multiplexer_plist() {
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
"http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.ssh-agent-multiplexer</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
       <string>/bin/sh</string>
       <string>-c</string>
       <string>export SSH_AUTH_SOCK="\$(launchctl getenv SSH_AUTH_SOCK)"; exec "\$HOME/.local/bin/ssh-agent-multiplexer" run</string>
    </array>
    <key>StandardOutPath</key>
    <string>${LOGS_DIR}/ssh-agent-multiplexer.log</string>
    <key>StandardErrorPath</key>
    <string>${LOGS_DIR}/ssh-agent-multiplexer.log</string>
</dict>
</plist>
PLIST
}

ssh_agent_multiplexer_uninstall() { rm -f "$HOME/.ssh/ssh-agent-multiplexer.sock"; }

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

# Returns 0 when the component is installed and current, RC_SKIPPED when a
# prerequisite is missing; any other failure exits through `set -e`.
install_one() {
  local c=$1 reason build_changed=0 run_changed=0 want_run="" label plist new actions=""

  reason=$(missing_reason "$c")
  if [ -n "$reason" ]; then
    warn "$c: skipped, $reason"
    return "$RC_SKIPPED"
  fi
  mkdir -p "$STATE_DIR"

  if has_build "$c"; then
    local want_build
    want_build=$(build_id "$c")
    if [ "$FORCE" = 1 ] || ! artifact_ok "$c" ||
      [ "$want_build" != "$(cat "$STATE_DIR/$c.build" 2>/dev/null)" ]; then
      log "$c: building"
      do_build "$c"
      printf '%s\n' "$want_build" >"$STATE_DIR/$c.build"
      build_changed=1
      actions="built"
    fi
  fi

  if has "$c" run_id; then
    want_run=$(call "$c" run_id)
    [ "$want_run" = "$(cat "$STATE_DIR/$c.run" 2>/dev/null)" ] || run_changed=1
  fi
  [ "$FORCE" = 1 ] && run_changed=1

  if has "$c" label; then
    label=$(call "$c" label)
    plist="$AGENTS_DIR/$label.plist"
    new=$(call "$c" plist)
    mkdir -p "$AGENTS_DIR" "$LOGS_DIR"
    if [ ! -f "$plist" ] || [ "$new" != "$(cat "$plist")" ]; then
      printf '%s\n' "$new" >"$plist"
      agent_reload "$label"
      actions="${actions:+$actions, }LaunchAgent installed and started"
    elif ! agent_loaded "$label"; then
      launchctl bootstrap "$DOMAIN" "$plist"
      actions="${actions:+$actions, }LaunchAgent loaded"
    elif [ "$build_changed" = 1 ] || [ "$run_changed" = 1 ]; then
      launchctl kickstart -k "$DOMAIN/$label" >/dev/null
      actions="${actions:+$actions, }restarted"
    fi
  elif has "$c" restart && { [ "$build_changed" = 1 ] || [ "$run_changed" = 1 ]; }; then
    local restarted
    restarted=$(call "$c" restart)
    actions="${actions:+$actions, }$restarted"
  fi

  if [ -n "$want_run" ]; then
    printf '%s\n' "$want_run" >"$STATE_DIR/$c.run"
  fi
  log "$c: ${actions:-up to date}"
}

cmd_install() {
  local explicit=0 names="" c rc failed="" skipped=""
  while [ $# -gt 0 ]; do
    case "$1" in
    -f | --force) FORCE=1 ;;
    -*) die "unknown option: $1" ;;
    *)
      is_component "$1" || die "unknown component: $1 (known: $COMPONENTS)"
      names="$names $1"
      explicit=1
      ;;
    esac
    shift
  done

  if [ "$explicit" = 0 ]; then
    for c in $(enabled_components); do
      if is_component "$c"; then
        names="$names $c"
      else
        warn "$ENABLED_FILE: unknown component '$c', ignored"
      fi
    done
    if [ -z "$names" ]; then
      log "No components enabled for this host (see .chezmoidata/services.yaml)."
      return 0
    fi
  fi

  for c in $names; do
    # A subshell with its own `set -e`, outside any condition (where bash
    # ignores errexit), so one broken component doesn't stop the others.
    set +e
    (
      set -e
      install_one "$c"
    )
    rc=$?
    set -e
    if [ "$rc" = "$RC_SKIPPED" ]; then
      skipped="$skipped $c"
    elif [ "$rc" != 0 ]; then
      warn "$c: FAILED"
      failed="$failed $c"
    fi
  done

  if [ -n "$failed" ]; then
    die "failed:$failed"
  fi
  # Skipping is fine for the host list (the prerequisite may still be on its
  # way), but not for a component that was asked for by name.
  if [ -n "$skipped" ] && [ "$explicit" = 1 ]; then
    die "not installed:$skipped"
  fi
}

restart_one() {
  local c=$1 label
  if has "$c" label; then
    label=$(call "$c" label)
    if agent_loaded "$label"; then
      launchctl kickstart -k "$DOMAIN/$label" >/dev/null
    elif [ -f "$AGENTS_DIR/$label.plist" ]; then
      launchctl bootstrap "$DOMAIN" "$AGENTS_DIR/$label.plist"
    else
      die "$c is not installed (run: dot-services install $c)"
    fi
    log "$c: restarted"
  elif has "$c" restart; then
    log "$c: $(call "$c" restart)"
  else
    log "$c: nothing to restart, it is started on demand"
  fi
}

uninstall_one() {
  local c=$1 label artifact
  if has "$c" label; then
    label=$(call "$c" label)
    agent_bootout "$label"
    rm -f "$AGENTS_DIR/$label.plist"
  fi
  if has "$c" uninstall; then
    call "$c" uninstall
  fi
  artifact=$(artifact_path "$c")
  case "$artifact" in
  "$HOME"/?*) rm -rf -- "$artifact" ;;
  esac
  rm -f "$STATE_DIR/$c.build" "$STATE_DIR/$c.run"
  log "$c: uninstalled"
}

cmd_each() {
  local action=$1 c
  shift
  [ $# -gt 0 ] || die "$action needs at least one component name (known: $COMPONENTS)"
  for c in "$@"; do
    is_component "$c" || die "unknown component: $c (known: $COMPONENTS)"
  done
  for c in "$@"; do
    "${action}_one" "$c"
  done
}

# Prints "current", "stale", "missing" or "-" (no build step).
build_state() {
  local c=$1
  has_build "$c" || {
    echo "-"
    return
  }
  if ! artifact_ok "$c"; then
    echo "missing"
  elif [ "$(build_id "$c")" != "$(cat "$STATE_DIR/$c.build" 2>/dev/null)" ]; then
    echo "stale"
  else
    echo "current"
  fi
}

# Prints the state of the running part: LaunchAgent, spawned process or "-".
run_state() {
  local c=$1 label pid
  if has "$c" label; then
    label=$(call "$c" label)
    if [ ! -f "$AGENTS_DIR/$label.plist" ]; then
      echo "not installed"
    elif ! agent_loaded "$label"; then
      echo "not loaded"
    else
      pid=$(agent_pid "$label")
      if [ -n "$pid" ]; then
        echo "running (pid $pid)"
      else
        echo "loaded, idle"
      fi
    fi
  elif has "$c" pid; then
    pid=$(call "$c" pid || true)
    if [ -n "$pid" ]; then
      echo "running (pid $pid)"
    else
      echo "not running"
    fi
  else
    echo "-"
  fi
}

is_installed() {
  local c=$1 artifact
  if has "$c" label && [ -f "$AGENTS_DIR/$(call "$c" label).plist" ]; then
    return 0
  fi
  artifact=$(artifact_path "$c")
  [ -n "$artifact" ] && [ -e "$artifact" ]
}

cmd_status() {
  local c enabled note reason
  printf '%-28s %-8s %-8s %s\n' "COMPONENT" "ENABLED" "BUILD" "STATE"
  for c in $COMPONENTS; do
    note=""
    if is_enabled "$c"; then
      enabled="yes"
      reason=$(missing_reason "$c")
      [ -z "$reason" ] || note="cannot install: $reason"
    else
      enabled="no"
      ! is_installed "$c" || note="installed, but not enabled for this host"
    fi
    if [ "$enabled" = "no" ] && ! is_installed "$c"; then
      printf '%-28s %-8s %-8s %s\n' "$c" "$enabled" "-" "-"
    else
      printf '%-28s %-8s %-8s %s\n' "$c" "$enabled" "$(build_state "$c")" "$(run_state "$c")"
    fi
    printf '    %s\n' "$(call "$c" desc)"
    [ -z "$note" ] || printf '    ! %s\n' "$note"
  done
}

usage() {
  cat <<USAGE
Usage: dot-services [status]
       dot-services install [--force] [NAME…]
       dot-services restart NAME…
       dot-services uninstall NAME…

  status     what is enabled for this host, built and running (default)
  install    build, install and restart whatever changed; without names, the
             components enabled for this host. --force rebuilds and restarts
             even when nothing changed
  restart    restart a component
  uninstall  stop a component and remove what install created

Components: $COMPONENTS
Host list:  $ENABLED_FILE (from .chezmoidata/services.yaml)
USAGE
}

main() {
  if [ "$(uname -s)" != "Darwin" ]; then
    die "dot-services only manages macOS LaunchAgents and builds"
  fi
  # LaunchAgents live in the per-user gui/<uid> domain; as root, `id -u` is 0
  # and launchctl would target gui/0, which does not exist.
  if [ "$(id -u)" -eq 0 ] || [ -n "${SUDO_USER:-}" ]; then
    die "do not run dot-services as root or with sudo"
  fi

  local cmd="${1:-status}"
  [ $# -eq 0 ] || shift
  case "$cmd" in
  status) cmd_status ;;
  install) cmd_install "$@" ;;
  restart) cmd_each restart "$@" ;;
  uninstall) cmd_each uninstall "$@" ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
  esac
}

main "$@"
