#!/usr/bin/env swift
// make-app-icon SYMBOL COLOR OUTPUT.icns
//
// Draws a macOS-style app icon, a white SF Symbol on a coloured rounded
// square, and writes it as an .icns file. dot-services uses it so the
// self-built daemon bundles show a recognisable icon in their notifications
// instead of the blank generic app icon. Nothing binary has to live in the
// dotfiles repo: the icon is rebuilt from two words in dot-services.
//
//   SYMBOL  SF Symbol name, e.g. paintpalette.fill (browse them in SF Symbols.app)
//   COLOR   background as RRGGBB or #RRGGBB
//   OUTPUT  target file; "x.icns" builds the icon, "x.png" writes a 1024 px preview
import AppKit

func fail(_ msg: String) -> Never {
  FileHandle.standardError.write("make-app-icon: \(msg)\n".data(using: .utf8)!)
  exit(1)
}

let args = CommandLine.arguments
guard args.count == 4 else { fail("usage: make-app-icon SYMBOL COLOR OUTPUT.icns") }
let symbolName = args[1]
let output = URL(fileURLWithPath: args[3])

let hex = args[2].hasPrefix("#") ? String(args[2].dropFirst()) : args[2]
guard hex.count == 6, let rgb = UInt32(hex, radix: 16) else { fail("bad colour '\(args[2])', want RRGGBB") }
let base = NSColor(
  srgbRed: CGFloat((rgb >> 16) & 0xff) / 255, green: CGFloat((rgb >> 8) & 0xff) / 255,
  blue: CGFloat(rgb & 0xff) / 255, alpha: 1)

guard NSImage(systemSymbolName: symbolName, accessibilityDescription: nil) != nil else {
  fail("no SF Symbol named '\(symbolName)'")
}

/// Renders the icon at `pixels` x `pixels`. All measures follow Apple's 1024 px
/// icon grid: an 824 px rounded square with a soft shadow, centred.
func render(pixels: Int) -> Data {
  guard
    let rep = NSBitmapImageRep(
      bitmapDataPlanes: nil, pixelsWide: pixels, pixelsHigh: pixels, bitsPerSample: 8,
      samplesPerPixel: 4, hasAlpha: true, isPlanar: false, colorSpaceName: .deviceRGB,
      bytesPerRow: 0, bitsPerPixel: 0),
    let ctx = NSGraphicsContext(bitmapImageRep: rep)
  else { fail("cannot create a \(pixels) px bitmap") }
  NSGraphicsContext.saveGraphicsState()
  NSGraphicsContext.current = ctx
  let unit = CGFloat(pixels) / 1024
  ctx.cgContext.scaleBy(x: unit, y: unit)

  let plateRect = NSRect(x: 100, y: 100, width: 824, height: 824)
  let plate = NSBezierPath(roundedRect: plateRect, xRadius: 185, yRadius: 185)

  // Drop shadow under the plate.
  NSGraphicsContext.saveGraphicsState()
  let plateShadow = NSShadow()
  plateShadow.shadowColor = NSColor.black.withAlphaComponent(0.3)
  plateShadow.shadowOffset = NSSize(width: 0, height: -10 * unit)
  plateShadow.shadowBlurRadius = 20 * unit
  plateShadow.set()
  base.setFill()
  plate.fill()
  NSGraphicsContext.restoreGraphicsState()

  // Vertical gradient: lighter at the top, darker at the bottom.
  let top = base.blended(withFraction: 0.28, of: .white) ?? base
  let bottom = base.blended(withFraction: 0.18, of: .black) ?? base
  NSGradient(starting: bottom, ending: top)?.draw(in: plate, angle: 90)

  // The symbol, white, scaled to fit a 500 px box in the middle.
  let config = NSImage.SymbolConfiguration(pointSize: 400, weight: .medium)
    .applying(NSImage.SymbolConfiguration(paletteColors: [.white]))
  guard
    let symbol = NSImage(systemSymbolName: symbolName, accessibilityDescription: nil)?
      .withSymbolConfiguration(config)
  else { fail("cannot configure symbol '\(symbolName)'") }
  let fit = min(500 / symbol.size.width, 500 / symbol.size.height)
  let size = NSSize(width: symbol.size.width * fit, height: symbol.size.height * fit)
  let symbolRect = NSRect(
    x: 512 - size.width / 2, y: 512 - size.height / 2, width: size.width, height: size.height)
  let symbolShadow = NSShadow()
  symbolShadow.shadowColor = NSColor.black.withAlphaComponent(0.22)
  symbolShadow.shadowOffset = NSSize(width: 0, height: -6 * unit)
  symbolShadow.shadowBlurRadius = 14 * unit
  symbolShadow.set()
  symbol.draw(in: symbolRect, from: .zero, operation: .sourceOver, fraction: 1)

  NSGraphicsContext.restoreGraphicsState()
  guard let png = rep.representation(using: .png, properties: [:]) else {
    fail("cannot encode the \(pixels) px image")
  }
  return png
}

do {
  if output.pathExtension == "png" {
    try render(pixels: 1024).write(to: output)
    exit(0)
  }
  guard output.pathExtension == "icns" else { fail("output must end in .icns or .png") }

  let fm = FileManager.default
  let iconset = fm.temporaryDirectory.appendingPathComponent("make-app-icon-\(getpid()).iconset")
  try? fm.removeItem(at: iconset)
  try fm.createDirectory(at: iconset, withIntermediateDirectories: true)
  defer { try? fm.removeItem(at: iconset) }
  for points in [16, 32, 128, 256, 512] {
    try render(pixels: points).write(
      to: iconset.appendingPathComponent("icon_\(points)x\(points).png"))
    try render(pixels: points * 2).write(
      to: iconset.appendingPathComponent("icon_\(points)x\(points)@2x.png"))
  }
  try fm.createDirectory(
    at: output.deletingLastPathComponent(), withIntermediateDirectories: true)
  let iconutil = Process()
  iconutil.executableURL = URL(fileURLWithPath: "/usr/bin/iconutil")
  iconutil.arguments = ["-c", "icns", "-o", output.path, iconset.path]
  try iconutil.run()
  iconutil.waitUntilExit()
  guard iconutil.terminationStatus == 0 else { fail("iconutil failed") }
} catch {
  fail("\(error)")
}
