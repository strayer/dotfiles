{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(npx lint-staged:*)",
      "Bash(npx prettier:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(tflint:*)",
      "Bash(markdownlint:*)",
      "Bash(shellcheck:*)",
      "Bash(step ssh login)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(git add:*)",
      "Bash(brew info:*)",
      "Bash(brew search:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "PATH=\"/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH\" claude-statusline",
    "padding": 0
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "PATH=\"/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH\" claude-statusline --subagents"
  },
  "tui": "fullscreen",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "env": {
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1"
  }
}
