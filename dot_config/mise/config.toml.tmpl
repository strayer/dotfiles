[settings]
experimental = true
idiomatic_version_file_enable_tools = []
npm.package_manager = "pnpm"

[tools]
"aqua:hashicorp/terraform" = "latest"
# removed from homebrew-core 2026-05 over its BUSL-1.1 relicensing
"aqua:terraform-linters/tflint" = "latest"
"npm:gh-actions-language-server" = "latest"
"npm:emmet-ls" = "latest"
"npm:vscode-langservers-extracted" = "latest"
"npm:svgexport" = "latest"
"npm:ccusage" = "latest"
{{- if get . "headless" }}
# official Obsidian Sync headless client (open beta). Headless-only: desktop
# Sync and headless sync must never run on the same device, Macs use the app.
# allow_builds: better-sqlite3 needs its postinstall (prebuild-install fetches
# the native .node); pnpm blocks dependency build scripts unless allowlisted
"npm:obsidian-headless" = { version = "latest", allow_builds = ["better-sqlite3"] }
{{- end }}
{{- if eq .chezmoi.hostname "CO-MBP-KC9KQV64V3" }}
maven = "latest"
"github:StackGuardian/sg-cli" = "latest"
{{- end }}

