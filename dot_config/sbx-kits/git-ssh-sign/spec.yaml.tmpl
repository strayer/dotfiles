{{- /* Local fork of the upstream git-ssh-sign kit:
     https://github.com/docker/sbx-kits-contrib/blob/main/git-ssh-sign/spec.yaml
     (synced 2026-08-18).

     Upstream resolves the signing key with `ssh-add -L | head -n 1`, i.e.
     whatever the forwarded agent happens to list first. Secretive serves
     several keys and the signing key is not first, so sandbox commits were
     signed with the wrong key. This fork pins it instead, from the same
     .chezmoidata/git.yaml the host ~/.gitconfig reads.

     Everything else is upstream verbatim — to re-sync, diff against the URL
     above and keep only the key-selection block below. Hosts with no entry in
     .chezmoidata/git.yaml keep upstream's head -n 1 behaviour. */ -}}
{{- $id := get .git.identities .chezmoi.hostname -}}
schemaVersion: "2"
kind: mixin
name: git-ssh-sign
displayName: Git SSH Commit Signing
description: Configures git to sign commits using the SSH key forwarded from the host's SSH agent.
sourceURL: https://github.com/docker/sbx-kits-contrib/tree/main/git-ssh-sign
agentInstructions:
  content: |
    ## Git commit signing

    This sandbox is configured to sign git commits with your host's SSH key.
    Commits and tags are signed automatically. Use `git log --show-signature`
    to verify signatures on existing commits.
setup:
  install:
    - command: |
        git config --system gpg.format ssh
        git config --system --unset-all user.signingKey || true
        git config --system commit.gpgSign true
        git config --system tag.gpgSign true
        git config --system gpg.ssh.defaultKeyCommand /home/agent/.config/git/ssh-signing-key-command
        git config --system gpg.ssh.allowedSignersFile /home/agent/.config/git/allowed_signers
        if [ "$(git config --system --get core.hooksPath || true)" = "/home/agent/.config/git/hooks" ]; then
            git config --system --unset-all core.hooksPath
        fi
      user: "0"
      description: Configure SSH commit signing with a dynamic key command
  files:
    - path: /home/agent/.config/git/ssh-signing-key-command
      content: |
        #!/bin/sh
        set -e

        if [ -z "$SSH_AUTH_SOCK" ]; then
            echo "[git-ssh-sign] no SSH agent - cannot sign commits" >&2
            exit 1
        fi

        {{ if $id -}}
        # Pinned host signing key (.chezmoidata/git.yaml) — the agent forwards
        # several keys and the right one is not necessarily first.
        key='{{ $id.signingkey }}'
        if ! ssh-add -L 2>/dev/null | grep -qF "$key"; then
            echo "[git-ssh-sign] configured signing key is not in the forwarded agent - cannot sign commits" >&2
            exit 1
        fi
        {{- else -}}
        key=$(ssh-add -L 2>/dev/null | head -n 1)
        if [ -z "$key" ]; then
            echo "[git-ssh-sign] no keys in SSH agent - cannot sign commits" >&2
            exit 1
        fi
        {{- end }}

        config_dir="$GIT_SSH_SIGN_CONFIG_DIR"
        if [ -z "$config_dir" ]; then
            config_dir="/home/agent/.config/git"
        fi
        mkdir -p "$config_dir"

        email=$(git config user.email 2>/dev/null || printf '%s' {{ if $id }}'{{ $id.email }}'{{ else }}"agent@sandbox.local"{{ end }})
        printf '%s %s\n' "$email" "$key" > "$config_dir/allowed_signers"
        printf 'key::%s\n' "$key"
      mode: "0755"
      description: Resolve the forwarded SSH agent key for Git SSH signing
