-- settings.lua - Global configuration and font settings

local M = {}

-- Font configuration
M.font = {
  text = "PragmataPro", -- Main font family
  numbers = "PragmataPro", -- Numbers font family
  app_icons = "sketchybar-app-font", -- App icons font family
}

-- Padding and spacing
M.paddings = {
  item_left = 5,
  item_right = 5,
  icon_left = 7,
  icon_right = 4,
  label_left = 4,
  label_right = 7,
}

-- Bar and island layout (clustered-island design)
-- bar_height 38 aligns with the notch bottom. A bar y_offset would misalign
-- text and bracket backgrounds vertically (the offset is applied to item
-- content but not to bracket backdrops), so the former 35+3 offset split is
-- folded into the height instead - same bottom edge, symmetric centering.
M.layout = {
  bar_height = 38,   -- Total bar height (notch-aligned)
  bar_y_offset = 0,  -- Keep 0: see note above
  bar_padding_h = 0, -- No extra edge padding: the outermost items' own 5pt
  -- item padding provides the screen-edge margin, matching rift's 5pt gaps
  pill_height = 31,  -- Island pill height
  island_gap = 5,    -- Visible spacing between islands (matches the 5pt
  -- screen-edge and rift window margins)
}

-- Update frequencies (in seconds)
M.update_freq = {
  clock = 10,
  battery = 120,
  network = 30,
  mealplan = 120,
  package_updates = 3600, -- Hourly updates
}

-- System detection
M.hostname = "{{ .chezmoi.hostname }}"
M.is_work_machine = M.hostname == "CO-MBP-KC9KQV64V3"

-- Absolute path for shelling back out to sketchybar via sbar.exec:
-- the launchd service PATH (/usr/bin:/bin:/usr/sbin:/sbin) does not
-- include /opt/homebrew/bin, so a bare `sketchybar` silently fails.
M.sketchybar_bin = "/opt/homebrew/bin/sketchybar"

return M

